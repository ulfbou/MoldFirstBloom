@inject GameSession Session

<section class="hand-tray" aria-label="Piece hand">
    @for (var slot = 0; slot < Session.State.Hand.Count; slot++)
    {
        var capturedSlot = slot;
        var piece = PieceCatalog.Get(Session.State.Hand[slot].PieceId);

        <button class="hand-card @(Session.SelectedSlot == slot ? "selected" : null)"
                disabled="@Session.IsResolving"
                @onclick="() => Session.SelectPiece(capturedSlot)">
            <strong>@piece.Name</strong>
            <span>@piece.Cells.Count cells</span>
        </button>
    }

    <button class="rotate-control"
            aria-label="Rotate selected piece"
            disabled="@(Session.IsResolving || Session.SelectedSlot is null)"
            @onclick="Session.Rotate">
        ↻
    </button>
</section>
