@inject GameSession Session

<div class="sheet-overlay" @onclick="IgnoreBackdrop">
    <section class="sheet-card game-over-card" role="dialog" aria-modal="true" aria-labelledby="game-over-title" @onclick:stopPropagation>
        <span class="sheet-handle" aria-hidden="true"></span>
        <h2 id="game-over-title">Garden Overgrown</h2>
        <p class="final-score">@Session.State.Score</p>
        <p>@Session.State.Turn turns · @Session.State.BloomCount blooms</p>
        <div class="sheet-actions">
            <button @onclick="Session.RematchAsync">Rematch same seed</button>
            <button @onclick="Session.NewGameAsync">New seed</button>
        </div>
    </section>
</div>

@code {
    private static void IgnoreBackdrop() { }
}
