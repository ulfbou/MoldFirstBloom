@page "/"
@implements IDisposable
@inject GameSession Session

<PageTitle>MOLD: First Bloom</PageTitle>

<div class="game-shell">
    <header class="game-header">
        <div>
            <h1>MOLD</h1>
            <span>First Bloom</span>
        </div>
        <div class="run-stats" aria-live="polite">
            <strong>@Session.State.Score</strong>
            <span>Turn @Session.State.Turn</span>
        </div>
    </header>

    <section class="progress-strip" aria-label="Prototype progress">
        Phase 1 vertical slice
    </section>

    <BoardView />

    <TeachingStrip />

    <HandTray />

    <footer class="bottom-controls">
        <FabBar SheetRequested="OpenSheet" />
        <div class="run-controls">
        <button class="primary-control" @onclick="Session.NewGameAsync">
            New seed
        </button>
        <button class="primary-control" @onclick="Session.RematchAsync">
            Rematch
        </button>
        </div>
    </footer>
</div>

<SheetHost ActiveSheet="_activeSheet" Closed="CloseSheet" />

@if (Session.State.IsGameOver)
{
    <GameOverSheet />
}

@code {
    private SheetKind? _activeSheet;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += HandleChanged;
        await Session.InitializeAsync();
    }

    private void HandleChanged() => InvokeAsync(StateHasChanged);

    private void OpenSheet(SheetKind sheet)
    {
        if (!Session.IsResolving)
        {
            _activeSheet = sheet;
        }
    }

    private void CloseSheet() => _activeSheet = null;

    public void Dispose() => Session.Changed -= HandleChanged;
}